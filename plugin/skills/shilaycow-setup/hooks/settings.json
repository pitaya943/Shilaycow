{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/shilaycow-guard.py\""}]
      },
      {
        "matcher": "mcp__.*(merge_pull_request|enable_pr_auto_merge|push_files|create_or_update_file|delete_file|create_branch|update_pull_request_branch).*",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/shilaycow-guard.py\""}]
      }
    ]
  }
}
